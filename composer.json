{
  "name": "sedophp/framework",
  "description": "A small, readable PHP framework built for shared hosting and everyday PHP.",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/sedatyildiznet/sedophp",
  "keywords": [
    "php",
    "framework",
    "shared-hosting",
    "cpanel",
    "mvc",
    "pdo"
  ],
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*"
  },
  "autoload": {
    "psr-4": {
      "SedoPHP\\": "src/",
      "App\\": "app/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "bin": [
    "sedo"
  ],
  "scripts": {
    "test": "@php tests/run.php",
    "lint": "@php tools/lint.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
