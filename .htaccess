Options -Indexes
RewriteEngine On

# Never expose framework internals when the project root itself is the document root.
RewriteRule ^(?:\.git|app|bootstrap|config|database|docs|routes|src|storage|tests|vendor)(?:/|$) - [F,L]
RewriteRule ^(?:\.env|composer\.(?:json|lock)|VERSION)(?:$|/) - [F,L]

# Shared-hosting fallback: internally send public requests to /public.
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [QSA,L]
